# Text Provenance Engine — Environment Configuration
# Copy to .env and fill in values. Never commit .env with real credentials.

# Database connection URL
# SQLite (local dev, default if unset):
#   DATABASE_URL=sqlite:///data/provenance.db
# PostgreSQL (production):
#   DATABASE_URL=postgresql://user:password@localhost:5432/provenance
# For Supabase on an IPv4-only host, use the dashboard's session-pooler
# connection string rather than the direct db.*:5432 hostname (often IPv6-only).
# Define DATABASE_URL only once; dotenv uses the last duplicate definition.
DATABASE_URL=

# API authentication key
# When set, all /v1/* endpoints require an X-API-Key header.
# Leave unset for local development (auth disabled).
# Always set in production.
# Note: managed API keys stored in the DB take precedence over this value.
PROVENANCE_API_KEY=

# Admin API key for key management endpoints
# When set, POST/DELETE /v1/api-keys require this key.
# The admin key also works as a normal API key for /v1/* endpoints.
# Leave unset to disable key management.
PROVENANCE_ADMIN_API_KEY=

# Daily usage limits (per API key, optional)
# When set, requests exceeding the limit return HTTP 429.
# Derived from the database (safe for multiple API instances).
# Separate from per-IP rate limiting.
PROVENANCE_DAILY_REQUEST_LIMIT=
PROVENANCE_DAILY_CHARACTER_LIMIT=

# Background job settings (Phase 3C)
# Max concurrent background worker threads for async analysis
PROVENANCE_MAX_BACKGROUND_JOBS=2
# Hours to retain completed/failed jobs before cleanup
PROVENANCE_JOB_RETENTION_HOURS=24

# Robustness dashboard source directory (Phase 6A)
# Directory tree scanned (recursively) for Phase 5 benchmark_results.jsonl
# artifacts served read-only by GET /v1/robustness/results and
# GET /v1/robustness/comparison for dashboard visualization.
PROVENANCE_ROBUSTNESS_DIR=data/robustness

# Model/tokenizer cache capacity per kind (Phase 6B)
# Bounded LRU; 0 disables caching (every benchmark reloads).
PROVENANCE_MODEL_CACHE_SIZE=2

# Simultaneous dashboard-triggered benchmark executions (Phase 6C)
# Additional runs wait in the background queue instead of running in parallel.
PROVENANCE_MAX_BENCHMARK_RUNS=1

# Browser dashboard access (local dev and docker-compose)
# Comma-separated origins allowed to call the API from a browser.
# The Vite dev server runs on http://localhost:5173 by default.
# The public website needs its origin here (cookies are SameSite=Lax,
# first-party, so no credentialed-CORS wildcard issues arise).
CORS_ORIGINS=http://localhost:5173

# ---------------- Product v2 (public SaaS) ----------------
# Anonymous visitor cookie signing secret (REQUIRED in production).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# When unset, the server uses an ephemeral per-process secret (cookies
# do not survive restarts) and logs a warning.
PROVENANCE_ANON_COOKIE_SECRET=
# Require HTTPS for the visitor cookie. Leave 0 for local http dev;
# set to 1 in any production deployment.
PROVENANCE_ANON_COOKIE_SECURE=0
# Cookie domain scope (e.g. example.com to share across subdomains).
# Leave empty for host-only cookies (local dev default).
PROVENANCE_ANON_COOKIE_DOMAIN=
# Cookie SameSite policy: lax (default), strict, or none.
PROVENANCE_COOKIE_SAMESITE=lax

# Public analyzer quota: successful anonymous analyses per UTC day.
PROVENANCE_PUBLIC_DAILY_LIMIT=2
# Max input characters per public analysis.
PROVENANCE_PUBLIC_MAX_CHARS=5000
# Signed-in free plan limits (entitlement layer; payments are Phase 7C).
PROVENANCE_FREE_DAILY_LIMIT=50
PROVENANCE_FREE_MAX_CHARS=20000
# Pro plan limits (plan is flipped manually until payments land).
PROVENANCE_PRO_DAILY_LIMIT=1000
PROVENANCE_PRO_MAX_CHARS=100000

# Supabase Auth (https://supabase.com → your project → Settings → API)
# Project URL (public; also needed as VITE_SUPABASE_URL in the frontend).
SUPABASE_URL=
# Publishable/anon key (PUBLIC — safe for the frontend bundle as
# VITE_SUPABASE_ANON_KEY; does NOT go in backend-only secrets).
SUPABASE_ANON_KEY=
# JWT secret (SECRET — backend only, never in the frontend bundle).
# Used to verify Supabase-issued access tokens (HS256).
SUPABASE_JWT_SECRET=
