# =========================================================
# TEXT PROVENANCE ENGINE — LOCAL / DEVELOPMENT CONFIG
# =========================================================

# ---------------------------------------------------------
# Environment
# ---------------------------------------------------------

PROVENANCE_ENVIRONMENT=development

# Optional explicit serverless test mode. Vercel supplies VERCEL=1 itself, so
# leave this empty in a normal Vercel deployment.
PROVENANCE_RUNTIME=


# ---------------------------------------------------------
# Database
# ---------------------------------------------------------

# Supabase PostgreSQL session pooler
DATABASE_URL=

# Local SQLite alternative:
# DATABASE_URL=sqlite:////home/edith/main/projects/text-provenance-engine/data/provenance.db


# ---------------------------------------------------------
# Legacy / Developer API Authentication
# ---------------------------------------------------------

PROVENANCE_API_KEY=
PROVENANCE_ADMIN_API_KEY=


# ---------------------------------------------------------
# API Usage Limits
# ---------------------------------------------------------

PROVENANCE_DAILY_REQUEST_LIMIT=1000
PROVENANCE_DAILY_CHARACTER_LIMIT=10000000

RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
MAX_LIST_LIMIT=100


# ---------------------------------------------------------
# Request / Proxy Hardening
# ---------------------------------------------------------

PROVENANCE_TRUST_PROXY=0
PROVENANCE_MAX_REQUEST_BODY_BYTES=1048576


# ---------------------------------------------------------
# Background Jobs
# ---------------------------------------------------------

PROVENANCE_MAX_BACKGROUND_JOBS=2
PROVENANCE_JOB_RETENTION_HOURS=24


# ---------------------------------------------------------
# Benchmark / Robustness Runtime
# ---------------------------------------------------------

PROVENANCE_MODEL_CACHE_SIZE=2
PROVENANCE_MAX_BENCHMARK_RUNS=1
PROVENANCE_ROBUSTNESS_DIR=data/robustness


# ---------------------------------------------------------
# CORS
# ---------------------------------------------------------

CORS_ORIGINS=


# ---------------------------------------------------------
# Anonymous Visitor Cookie
# ---------------------------------------------------------

PROVENANCE_ANON_COOKIE_SECRET=

# Local HTTP development
PROVENANCE_ANON_COOKIE_SECURE=0

# Empty = host-only cookie
PROVENANCE_ANON_COOKIE_DOMAIN=

PROVENANCE_COOKIE_SAMESITE=lax


# ---------------------------------------------------------
# Anonymous Public Plan
# ---------------------------------------------------------

PROVENANCE_PUBLIC_DAILY_LIMIT=2
PROVENANCE_PUBLIC_MAX_CHARS=5000


# ---------------------------------------------------------
# Signed-in Free Plan
# ---------------------------------------------------------

PROVENANCE_FREE_DAILY_LIMIT=50
PROVENANCE_FREE_MAX_CHARS=20000


# ---------------------------------------------------------
# Pro Plan
# ---------------------------------------------------------

PROVENANCE_PRO_DAILY_LIMIT=1000
PROVENANCE_PRO_MAX_CHARS=100000


# ---------------------------------------------------------
# Supabase Auth
# ---------------------------------------------------------

SUPABASE_URL=

# NOTE:
# Backend currently does NOT consume SUPABASE_ANON_KEY.
# Keep the publishable key in dashboard/.env as
# VITE_SUPABASE_ANON_KEY instead.

# Needed only when the Supabase project uses legacy HS256 JWT signing.
# Modern Supabase RS256/ES256 signing keys are verified via the public JWKS.
SUPABASE_JWT_SECRET=


# ---------------------------------------------------------
# Razorpay Recurring Subscriptions
# ---------------------------------------------------------

# Fill after Razorpay KYC / Test API access is available.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PLAN_ID=

RAZORPAY_PRO_TOTAL_COUNT=120
