# Dashboard (Vite) environment — copy to .env for local development.
# Only VITE_* variables are exposed to the browser bundle. Never put
# secrets here: SUPABASE_JWT_SECRET and PROVENANCE_* stay server-side.

# Backend API base URL used by the public site and SaaS workspace.
# Local: http://localhost:8000 (or /api when using Vercel dev).
# Vercel production: leave blank; the app safely defaults to same-origin /api.
VITE_API_BASE_URL=http://localhost:8000

# Supabase Auth (public values only — same project as backend SUPABASE_URL).
# Leave both unset to run the legacy developer console (API key flow).
# Google OAuth is configured in Supabase Dashboard → Authentication →
# Providers → Google. Do not add a Google client ID or client secret here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Razorpay's public Key ID is returned only in a signed-in backend
# checkout response. Do not add a VITE_RAZORPAY_KEY_ID variable.
