# Dashboard (Vite) environment — copy to .env for local development.
# Only VITE_* variables are exposed to the browser bundle. Never put
# secrets here: SUPABASE_JWT_SECRET and PROVENANCE_* stay server-side.

# Backend API base URL used by the public site and SaaS workspace.
VITE_API_BASE_URL=http://localhost:8000

# Supabase Auth (public values only — same project as backend SUPABASE_URL).
# Leave both unset to run the legacy developer console (API key flow).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
